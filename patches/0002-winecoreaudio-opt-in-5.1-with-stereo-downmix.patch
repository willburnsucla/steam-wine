+static BOOL force_5_1(void)
+{
+    const char *force = getenv("WINE_COREAUDIO_FORCE_5_1");
+    return force && *force && *force != '0';
+}
+
+/* 5.1 (FL FR FC LFE BL BR or FL FR FC LFE SL SR) in 32-bit float or 16-bit PCM? */
+static BOOL is_downmixable_5_1(const WAVEFORMATEX *fmt)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)fmt;
+    BOOL is_float, is_pcm;
+
+    if(fmt->nChannels != 6) return FALSE;
+    if(fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE){
+        if(fmtex->dwChannelMask != KSAUDIO_SPEAKER_5POINT1 &&
+           fmtex->dwChannelMask != KSAUDIO_SPEAKER_5POINT1_SURROUND) return FALSE;
+        is_float = IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_IEEE_FLOAT);
+        is_pcm = IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_PCM);
+    }else{
+        is_float = fmt->wFormatTag == WAVE_FORMAT_IEEE_FLOAT;
+        is_pcm = fmt->wFormatTag == WAVE_FORMAT_PCM;
+    }
+    return (is_float && fmt->wBitsPerSample == 32) || (is_pcm && fmt->wBitsPerSample == 16);
+}
+
+/* Mix 5.1 down to stereo: L = FL + c*FC + c*BL, R = FR + c*FC + c*BR, c = 1/sqrt(2).
+ * LFE is dropped. Results are clipped to the format's range. */
+static void downmix_5_1_to_stereo(const WAVEFORMATEX *fmt, const BYTE *src, BYTE *dst, UINT32 frames)
+{
+    static const float c = 0.70710678f;
+    BOOL is_float = fmt->wBitsPerSample == 32;
+    UINT32 i;
+
+    for(i = 0; i < frames; i++){
+        float in[6], l, r;
+        int ch;
+
+        for(ch = 0; ch < 6; ch++)
+            in[ch] = is_float ? ((const float *)src)[i * 6 + ch] : ((const INT16 *)src)[i * 6 + ch] / 32768.0f;
+        l = in[0] + c * in[2] + c * in[4];
+        r = in[1] + c * in[2] + c * in[5];
+        l = l > 1.0f ? 1.0f : (l < -1.0f ? -1.0f : l);
+        r = r > 1.0f ? 1.0f : (r < -1.0f ? -1.0f : r);
+        if(is_float){
+            ((float *)dst)[i * 2] = l;
+            ((float *)dst)[i * 2 + 1] = r;
+        }else{
+            ((INT16 *)dst)[i * 2] = (INT16)(l * 32767.0f);
+            ((INT16 *)dst)[i * 2 + 1] = (INT16)(r * 32767.0f);
+        }
+    }
+}
